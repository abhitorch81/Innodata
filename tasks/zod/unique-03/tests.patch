+test("rule_core: c0", () => {
+    const r = z.array(z.any()).unique().safeParse(["a", "a"]);
+    expect(r.success).toBe(false);
+    expect(r.success ? [] : r.error.issues.every((i) => i.code === "custom" && i.message.length > 0)).toBe(true);
+});
+
