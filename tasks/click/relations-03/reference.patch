+    def _check_option_relations(self, ctx: Context) -> None:
+        """Fail with a usage error for ``conflicts_with`` / ``requires`` violations."""
+        options = [p for p in self.get_params(ctx) if isinstance(p, Option)]
+        by_name = {p.name: p for p in options}
+
+        def provided(param: Option) -> bool:
+            source = ctx.get_parameter_source(param.name)
+            if not (source is ParameterSource.COMMANDLINE or source is ParameterSource.ENVIRONMENT):
+                return False
+            return bool(ctx.params.get(param.name))
+
+        violations: list[list[Option]] = []
+        seen: set[frozenset[str | None]] = set()
+        for opt in options:
+            if not provided(opt):
+                continue
+            for name in opt.conflicts_with:
+                other = by_name.get(name)
+                if other is None or other is opt or not provided(other):
+                    continue
+                pair = frozenset((opt.name, other.name))
+                if pair not in seen:
+                    seen.add(pair)
+                    violations.append([opt, other])
+
+        if not violations:
+            return
+        lines = [
+            _("Conflicting or incomplete options: {options}.").format(
+                options=", ".join(o.opts[0] for o in group)
+            )
+            for group in violations
+        ]
+        raise UsageError("\n".join(lines), ctx=ctx)
+
