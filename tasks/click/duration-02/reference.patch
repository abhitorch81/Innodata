+class Duration(ParamType[timedelta]):
+    """Convert strings such as ``90s`` or ``1h30m`` into :class:`~datetime.timedelta`.
+
+    A value is a number followed by a unit suffix.
+    """
+
+    name = "duration"
+
+    _UNITS: t.ClassVar[dict[str, str]] = {
+        "w": "604800",
+        "h": "3600",
+        "m": "60",
+        "s": "1",
+    }
+    _NUMBER = re.compile(r"[0-9]+")
+    _SEGMENT = re.compile(r"(?P<number>[0-9]+)(?P<unit>[A-Za-z]+)")
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            result = value
+        else:
+            result = self._parse(value)
+
+            if result is None:
+                self.fail(_("{value!r} is not a valid duration.").format(value=value), param, ctx)
+
+        if (self.min is not None and result < self.min) or (
+            self.max is not None and result > self.max
+        ):
+            self.fail(_("{value!r} is outside the allowed duration range.").format(value=value), param, ctx)
+
+        return result
+
+    def _parse(self, value: t.Any) -> timedelta | None:
+        from decimal import Decimal  # lazy: keeps `import click` light
+
+        if not isinstance(value, str):
+            return None
+
+        text = value
+        sign = 1
+        if not text:
+            return None
+
+        if self._NUMBER.fullmatch(text):
+            total = Decimal(text)
+            return self._build(total, sign)
+
+        total = Decimal(0)
+        pos = 0
+        count = 0
+        previous = None
+        while pos < len(text):
+            m = self._SEGMENT.match(text, pos)
+            if m is None:
+                return None
+
+            unit = m.group("unit")
+            spec = self._UNITS.get(unit)
+            if spec is None:
+                return None
+            factor = Decimal(spec)
+            if previous is not None and factor >= previous:
+                return None
+            previous = factor
+            total += Decimal(m.group("number")) * factor
+            count += 1
+            pos = m.end()
+
+        return self._build(total, sign)
+
+    @staticmethod
+    def _build(total: t.Any, sign: int) -> timedelta | None:
+        micros = int((total * 1_000_000).to_integral_value())
+        try:
+            return timedelta(microseconds=sign * micros)
+        except OverflowError:
+            return None
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
+
 class _NumberParamTypeBase(
