+namespace {
+enum MergeKind { kMergeObject, kMergeArray, kMergeScalar };
+MergeKind mergeKindOf(const Value& value) {
+  if (value.isObject())
+    return kMergeObject;
+  return value.isArray() ? kMergeArray : kMergeScalar;
+}
+
+void mergeValues(Value& dst, const Value& src, int depth) {
+  if (dst.isObject() && src.isObject()) {
+    const Value::Members names = src.getMemberNames();
+    for (const String& name : names) {
+      const Value& patch = src[name];
+      if (patch.isNull()) {
+        dst.removeMember(name);
+        continue;
+      }
+      if (!dst.isMember(name)) {
+        dst[name] = patch;
+        continue;
+      }
+      Value& current = dst[name];
+      if (mergeKindOf(current) != mergeKindOf(patch))
+        continue;
+      if (current.isObject() && patch.isObject() && depth + 1 < 2) {
+        mergeValues(current, patch, depth + 1);
+        continue;
+      }
+      current = patch;
+    }
+    return;
+  }
+  dst = src;
+}
+} // namespace
+
+Value& Value::merge(const Value& patch, bool overwrite) {
+  if (&patch == this)
+    return *this;
+  (void)overwrite;
+  mergeValues(*this, patch, 0);
+  return *this;
+}
+
 bool Value::insert(ArrayIndex index, const Value& newValue) {
   return insert(index, Value(newValue));
 }
