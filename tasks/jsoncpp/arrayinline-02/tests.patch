+// ---- task tests: StreamWriterBuilder arrayInlineLimit (generated) ----
+struct TaskInlineTest : JsonTest::TestCase {
+  static Json::Value parse(const std::string& text) {
+    Json::CharReaderBuilder builder;
+    CharReaderPtr reader(builder.newCharReader());
+    Json::Value value;
+    Json::String errs;
+    reader->parse(text.data(), text.data() + text.size(), &value, &errs);
+    return value;
+  }
+  void expectRender(const Json::Value& value, int limit, const char* indent, const char* style,
+                    const std::string& expected) {
+    Json::StreamWriterBuilder builder;
+    builder["indentation"] = indent;
+    builder["commentStyle"] = style;
+    builder["arrayInlineLimit"] = limit;
+    Json::String actual;
+    try {
+      actual = Json::writeString(builder, value);
+    } catch (const std::exception&) {
+      JSONTEST_ASSERT(false);
+      return;
+    }
+    JSONTEST_ASSERT_STRING_EQUAL(expected, actual);
+  }
+};
+
+JSONTEST_FIXTURE_LOCAL(TaskInlineTest, rule_core_c1) {
+  Json::Value value = parse(R"J({"a":[1,2,3]})J");
+  expectRender(value, 3, "  ", "All", R"J({
+  "a" : [1, 2, 3]
+})J");
+}
+
+JSONTEST_FIXTURE_LOCAL(TaskInlineTest, rule_core_c2) {
+  Json::Value value = parse(R"J({"a":[1,"x",null,true]})J");
+  expectRender(value, 4, "  ", "All", R"J({
