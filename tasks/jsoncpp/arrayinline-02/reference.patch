+void BuiltStyledStreamWriter::configureInline(unsigned int limit) { inlineLimit_ = limit; }
+
+String BuiltStyledStreamWriter::inlineScalarText(Value const& value) {
+  ChildValues saved;
+  saved.swap(childValues_);
+  const bool savedAdd = addChildValues_;
+  addChildValues_ = true;
+  writeValue(value);
+  String text = childValues_.empty() ? String() : childValues_.back();
+  childValues_.swap(saved);
+  addChildValues_ = savedAdd;
+  return text;
+}
+
+bool BuiltStyledStreamWriter::buildInlineArray(Value const& value, String& out,
+                                               unsigned int& leaves) {
+  ArrayIndex const size = value.size();
+  if (size == 0)
+    return false;
+  String text = "[";
+  unsigned int own = 0;
+  for (ArrayIndex index = 0; index < size; ++index) {
+    Value const& child = value[index];
+    if (index > 0)
+      text += ", ";
+    if (child.isArray() || child.isObject()) {
+      if (child.isArray()) {
+        String inner;
+        unsigned int innerLeaves = 0;
+        if (!buildInlineArray(child, inner, innerLeaves))
+          return false;
+        text += inner;
+        own += innerLeaves;
+        continue;
+      }
+      return false;
+    }
+    text += inlineScalarText(child);
+    ++own;
+  }
+  if (own > inlineLimit_)
+    return false;
+  text += "]";
+  if (text.size() > 22)
+    return false;
+  out = text;
+  leaves = own;
+  return true;
+}
+
+bool BuiltStyledStreamWriter::inlineArrayText(Value const& value, String& out) {
+  if (inlineLimit_ == 0 || indentation_.empty())
+    return false;
+  if (&value == rootValue_)
+    return false;
+  unsigned int leaves = 0;
+  return buildInlineArray(value, out, leaves);
+}
